# 76543210
# xxyyyzzz
#   ppq

field p = bc de hl sp
field r = b c d e h l (hl)/delay=1 a
field q = add:add8+0 adc:add8+carry sub:sub8+0 sbc:sub8+carry
field w = and:and8 xor:xor8 or:or8 -
field b = 0 1 2 3 4 5 6 7
# never renamed by a view: the register operand of an indexed load stays real
field s = b c d e h l - a

table base

00000000     | nop             | nop
01110110     | halt            | ld8 halted <- 1
00pp0001 n n | ld {p}, $nnnn   | ld16 {p} <- n
00yyy110 n   | ld {r:y}, $nn   | ld8 {r:y} <- n
00000010     | ld (bc), a      | ld8 (bc) <- a
00010010     | ld (de), a      | ld8 (de) <- a
00001010     | ld a, (bc)      | ld8 a <- (bc)
00011010     | ld a, (de)      | ld8 a <- (de)
00pp0011     | inc {p}         | inc16 {p} <- {p} ; delay 2
00pp1011     | dec {p}         | dec16 {p} <- {p} ; delay 2
00100111     | daa             | daa a, flags <- a flags
00101111     | cpl             | cpl a, flags <- a flags
00110111     | scf             | scf -, flags <- a flags
00111111     | ccf             | ccf -, flags <- a flags
00yyy100     | inc {r:y}       | inc8 {r:y}, flags <- {r:y} flags
00yyy101     | dec {r:y}       | dec8 {r:y}, flags <- {r:y} flags
01yyyzzz     | ld {r:y}, {r:z} | ld8 {r:y} <- {r:z}
100qqzzz     | {q} a, {r:z}    | {q} a, flags <- a {r:z}
101wwzzz     | {w} {r:z}       | {w} a, flags <- a {r:z}
10111zzz     | cp {r:z}        | cmp8 -, flags <- a {r:z}
110qq110 n   | {q} a, $nn      | {q} a, flags <- a n
111ww110 n   | {w} $nn         | {w} a, flags <- a n
11111110 n   | cp $nn          | cmp8 -, flags <- a n
11001011     | (cb)            | goto cb
11011101     | (dd)            | goto ix
11111101     | (fd)            | goto iy

table cb

01bbb110     | bit {b}, (hl)   | bit8 flags <- (hl) {b} flags h ; delay 1
01bbbzzz     | bit {b}, {r:z}  | bit8 flags <- {r:z} {b} flags {r:z}
10bbbzzz     | res {b}, {r:z}  | res8 {r:z} <- {r:z} {b}
11bbbzzz     | set {b}, {r:z}  | set8 {r:z} <- {r:z} {b}

# `dd`/`fd` re-read the base table with hl renamed. The two override rows are
# the one case the rename gets wrong: in `ld r, (ix+d)` the register operand is
# the real h or l, so it names a vocabulary a view does not touch.

table ix = base with hl -> ix, h -> ixh, l -> ixl, (hl) -> (ix+d)/delay=1

01yyy110     | ld {s:y}, (ix+d) | ld8 {s:y} <- (ix+d)
01110zzz     | ld (ix+d), {s:z} | ld8 (ix+d) <- {s:z}
11001011 d   | (dd cb)          | goto ddcb

table iy = base with hl -> iy, h -> iyh, l -> iyl, (hl) -> (iy+d)/delay=1

01yyy110     | ld {s:y}, (iy+d) | ld8 {s:y} <- (iy+d)
01110zzz     | ld (iy+d), {s:z} | ld8 (iy+d) <- {s:z}
11001011 d   | (fd cb)          | goto fdcb

# `dd cb d op` is the one encoding whose opcode is not its last byte, so the
# row above reads the displacement and hands it on. These rows are not `cb`
# renamed: every one of them works on memory, and the low bits name a register
# the result is *also* copied into. Reading them as a view is the bug that makes
# v2 and v3 wrong for 224 of 256 entries.

table ddcb

01bbbzzz     | bit {b}, (ix+d)          | bit8 flags <- (ix+d) {b} flags wzh ; delay 1
10bbb110     | res {b}, (ix+d)          | res8 (ix+d)/delay=1 <- (ix+d) {b}
10bbbzzz     | res {b}, (ix+d), {s:z}   | res8 (ix+d)/delay=1 {s:z} <- (ix+d) {b}
11bbb110     | set {b}, (ix+d)          | set8 (ix+d)/delay=1 <- (ix+d) {b}
11bbbzzz     | set {b}, (ix+d), {s:z}   | set8 (ix+d)/delay=1 {s:z} <- (ix+d) {b}

table fdcb

01bbbzzz     | bit {b}, (iy+d)          | bit8 flags <- (iy+d) {b} flags wzh ; delay 1
10bbb110     | res {b}, (iy+d)          | res8 (iy+d)/delay=1 <- (iy+d) {b}
10bbbzzz     | res {b}, (iy+d), {s:z}   | res8 (iy+d)/delay=1 {s:z} <- (iy+d) {b}
11bbb110     | set {b}, (iy+d)          | set8 (iy+d)/delay=1 <- (iy+d) {b}
11bbbzzz     | set {b}, (iy+d), {s:z}   | set8 (iy+d)/delay=1 {s:z} <- (iy+d) {b}
