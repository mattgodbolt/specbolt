# 76543210
# xxyyyzzz
#   ppq

field p = bc de hl sp
field r = b c d e h l - a
field q = add:add8+0 adc:add8+carry sub:sub8+0 sbc:sub8+carry
field w = and:and8 xor:xor8 or:or8 cp:cmp8

00000000 | nop           | nop
01110110 | halt          | ld8 halted <- 1
00pp0001 | ld {p}, $nnnn | ld16 {p} <- nn
00pp0011 | inc {p}       | inc16 {p} <- {p}
00pp1011 | dec {p}       | dec16 {p} <- {p}
00100111 | daa           | daa a, f <- a f
00101111 | cpl           | cpl a, f <- a f
00110111 | scf           | scf a, f <- a f
00111111 | ccf           | ccf a, f <- a f
00yyy100 | inc {r:y}     | inc8 {r:y}, f <- {r:y} f
00yyy101 | dec {r:y}     | dec8 {r:y}, f <- {r:y} f
01yyyzzz | ld {r:y}, {r:z} | ld8 {r:y} <- {r:z}
100qqzzz | {q} a, {r:z}  | {q} a, f <- a {r:z}
101wwzzz | {w} {r:z}     | {w} a, f <- a {r:z}
110qq110 | {q} a, $nn    | {q} a, f <- a n
111ww110 | {w} $nn       | {w} a, f <- a n
