# The documented NMOS 6502, as refract can describe it with `mode` blocks. A spike: see z80/v4/notes/6502.md for what
# this shape says about the format, and where it bends.
#
# The 6502 lays its opcodes out as `aaabbbcc`: `cc` picks a group, `aaa` the operation within it, and `bbb` the
# addressing mode. The operation is a vocabulary, and the addressing mode is a `mode`: a block whose members are pieces
# of a row, each bringing the bytes it adds to the instruction, the text it renders, the operand it stands for, and the
# steps that form that operand. Indexed and indirect modes form their address through `ea`, the chip's internal
# effective-address latch.

# The accumulator group's modes, `cc = 01`, chosen by `bbb`.
mode am
000 n   | ($nn,x) | (ea) | zp_index ea <- n x ; zp_pointer ea <- ea
001 n   | $nn     | (n)  |
010 n   | #$nn    | n    |
011 n n | $nnnn   | (n)  |
100 n   | ($nn),y | (ea) | zp_pointer ea <- n ; index ea <- ea y
101 n   | $nn,x   | (ea) | zp_index ea <- n x
110 n n | $nnnn,y | (ea) | index ea <- n y
111 n n | $nnnn,x | (ea) | index ea <- n x

# `sta` has every one of them but immediate.
mode store = am with 010 -> -

# The read-modify-write group's modes, `cc = 10`, where `010` is the accumulator itself. A write back through memory
# writes the old value before the new one, which is the idle cycle the `/delay=1` charges; the accumulator's own dummy
# cycle is a step.
mode rmw
001 n   | $nn     | (n)/delay=1  |
010     | a       | a            | delay 1
011 n n | $nnnn   | (n)/delay=1  |
101 n   | $nn,x   | (ea)/delay=1 | zp_index ea <- n x
111 n n | $nnnn,x | (ea)/delay=1 | index ea <- n x

# The index registers' modes. `ldy` indexes by `x`; `ldx` has the same modes indexed by `y`, and its zero-page one
# exists nowhere else, so it is written out rather than derived.
mode ldy
000 n   | #$nn    | n    |
001 n   | $nn     | (n)  |
011 n n | $nnnn   | (n)  |
101 n   | $nn,x   | (ea) | zp_index ea <- n x
111 n n | $nnnn,x | (ea) | index ea <- n x

mode ldx
000 n   | #$nn    | n    |
001 n   | $nn     | (n)  |
011 n n | $nnnn   | (n)  |
101 n   | $nn,y   | (ea) | zp_index ea <- n y
111 n n | $nnnn,y | (ea) | index ea <- n y

mode sty = ldy with 000 -> -, 111 -> -
mode stx = ldx with 000 -> -, 111 -> -
mode cp  = ldy with 101 -> -, 111 -> -

# `bit` and `jmp`, one opcode bit apart in each: zero page or absolute, and absolute or indirect.
mode za
0 n   | $nn   | (n) |
1 n n | $nnnn | (n) |

mode jm
0 n n | $nnnn   | n  |
1 n n | ($nnnn) | ea | jmp_pointer ea <- n

vocab alu = ora:ora8 and:and8 eor:eor8 adc:adc8 - lda:lda8 cmp:cmp8 sbc:sbc8
vocab rmw_op = asl:asl8 rol:rol8 lsr:lsr8 ror:ror8 - - dec:dec8 inc:inc8

# The index registers, where one opcode bit chooses between them.
vocab xy = y x

# The branches: a status bit, and whether it must be clear or set.
vocab cond = bpl:bit_clear(0x80) bmi:bit_set(0x80) bvc:bit_clear(0x40) bvs:bit_set(0x40) \
             bcc:bit_clear(0x01) bcs:bit_set(0x01) bne:bit_clear(0x02) beq:bit_set(0x02)

# The status instructions, one bit each; the slot `tya` occupies is a hole.
vocab flagop = clc:flag(0x01,0) sec:flag(0x01,1) cli:flag(0x04,0) sei:flag(0x04,1) \
               - clv:flag(0x40,0) cld:flag(0x08,0) sed:flag(0x08,1)

# The two pushes, which differ in what they push and how.
vocab push = php:push_status pha:push8
vocab pushed = p a

table main

# The single-byte instructions, first, because some of them sit in slots a group below also claims (`dex` and `nop`
# are where `dec a` and `inc a` would be). Every one takes two cycles, the second a dummy read.
10011000     | tya                | load8 a, p <- y p ; delay 1
10001010     | txa                | load8 a, p <- x p ; delay 1
10011010     | txs                | ld8 s <- x ; delay 1
10111010     | tsx                | load8 x, p <- s p ; delay 1
10001000     | dey                | dec8 y, p <- y p ; delay 1
11001010     | dex                | dec8 x, p <- x p ; delay 1
11101010     | nop                | delay 1
101010r0     | ta{xy:r}           | load8 {xy:r}, p <- a p ; delay 1
11r01000     | in{xy:r}           | inc8 {xy:r}, p <- {xy:r} p ; delay 1
0r001000     | {push:r}           | delay 1 ; {push:r} {pushed:r}
00101000     | plp                | delay 2 ; pull_status p <-
01101000     | pla                | delay 2 ; pull8 a <- ; load8 a, p <- a p
fff11000     | {flagop:f}         | {flagop:f} p <- p ; delay 1

# Calls, returns and the interrupt. `jsr` pushes the address of its own last byte, and `rts` steps past it.
00000000     | brk                | delay 1 ; brk
00100000 n n | jsr $nnnn          | delay 1 ; dec16 ea <- pc ; push16 ea ; ld16 pc <- n
01000000     | rti                | delay 2 ; pull_status p <- ; pull16 pc <-
01100000     | rts                | delay 2 ; pull16 ea <- ; inc16 pc <- ea ; delay 1

# The branches, all eight in one row. Two cycles untaken; the machine charges for taking it and for a page crossed.
fff10000 n   | {cond:f} $e        | {cond:f} p ; branch pc <- pc n

# The groups, one row each: the operation from `aaa`, the addressing mode from `bbb`.
aaabbb01     | {alu:a} {am:b}     | {alu:a} a, p <- a {am:b} p
100bbb01     | sta {store:b}      | ld8 {store:b} <- a
aaabbb10     | {rmw_op:a} {rmw:b} | {rmw_op:a} {rmw:b}, p <- {rmw:b} p
101bbb10     | ldx {ldx:b}        | load8 x, p <- {ldx:b} p
101bbb00     | ldy {ldy:b}        | load8 y, p <- {ldy:b} p
100bbb10     | stx {stx:b}        | ld8 {stx:b} <- x
100bbb00     | sty {sty:b}        | ld8 {sty:b} <- y
11rbbb00     | cp{xy:r} {cp:b}    | cmp8 {xy:r}, p <- {xy:r} {cp:b} p
0010z100     | bit {za:z}         | bit8 p <- a {za:z} p
01j01100     | jmp {jm:j}         | ld16 pc <- {jm:j}

# Everything else is undocumented, and some of it halts the chip. Not modelled.
xxxxxxxx     | ???                | delay 1
